# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
lcov.info

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem

# debug + logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
/logs/

# env files, secrets stay local; the placeholder template is committed
.env*
!.env.example

# neon CLI local context (org/project linkage for this checkout)
.neon

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors / IDE (project agent configs like .opencode/ are intentionally tracked)
.vscode/
.idea/
*.swp
*.swo
*~
PRD.md
PROGRESS.md
