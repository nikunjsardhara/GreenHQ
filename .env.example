# Copy to .env (local) or set in hosting env. Never commit real secrets.
# Setup: `bunx neon@latest init` (writes .env for you), or paste values from
# console.neon.tech → your project → Connect. Guide: neon.com/docs/guides/nextjs

# Primary Postgres connection, Neon pooled URL (works everywhere: local dev,
# CI, serverless). Get it from `bunx neon init` or the Neon Console → Connect
# (use the *pooled* connection string with your password filled in).
DATABASE_URL="postgresql://<user>:<password>@<endpoint-host>.neon.tech:5432/<dbname>?sslmode=require&channel_binding=require"

# Local Postgres fallback for fully-offline dev (see scripts/setup.ts).
# Comment out the Neon URL above and uncomment this to use it instead.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/GreenHQ"

# Neon API key for the `neon` CLI (schema push, branches, projects).
# Create at https://console.neon.tech/app/settings/api-keys, then
# `export NEON_API_KEY="napi_..."` (or add it to .env, never commit it).
NEON_API_KEY=""

# Optional: pin the Neon project this checkout is linked to
# (`neon init` manages this automatically, leave blank otherwise).
# NEON_PROJECT_ID=""

# Neon Auth (Managed Better Auth / Stack Auth under the hood). If
# NEON_AUTH_JWKS_URL is set, the app verifies Neon-issued JWTs against it;
# otherwise it uses the built-in email/password + JWT-cookie session
# (swappable, see src/lib/auth.ts).
# NEON_AUTH_JWKS_URL=""
# NEXT_PUBLIC_NEON_AUTH_URL=""

# Secret for signing built-in session / invite / password-reset tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me"

# Public base URL, used in QR payloads (https://<domain>/t/<nanoid>)
# and OG images / share links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional email provider for invites / gift claims / digests.
# The notifications module logs to console when unset (dev mode).
# RESEND_API_KEY=""
# EMAIL_FROM="GreenHQ <no-reply@example.org>"

# VAPID keys for PWA push notifications (optional for v1).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
